{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    ".env"
  ],
  "globalEnv": [
    "NODE_ENV",
    "SKRIBBLE_USERNAME",
    "SKRIBBLE_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^generate-models"
      ],
      "outputs": [
        "dist/**",
        "**/generated/**",
        "openapi.yaml",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "docs#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "run-examples": {
      "cache": false,
      "persistent": true
    },
    "generate-models": {
      "inputs": [
        "../../schemas/models.yaml",
        "generate_models.py"
      ],
      "outputs": [
        "../../sdks/typescript/src/types.ts",
        "../../sdks/python/skribble/models.py"
      ],
      "cache": true
    },
    "publish-py-sdk": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}