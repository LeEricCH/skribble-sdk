{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["models"],
  "additionalProperties": false,
  "properties": {
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "type": { 
            "type": "string",
            "enum": ["object", "array", "string", "number", "integer", "boolean", "union"]
          },
          "types": {
            "type": "array",
            "items": { "type": "string" }
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": { 
                  "type": "string",
                  "oneOf": [
                    {
                      "enum": ["string", "number", "integer", "boolean", "array", "object"]
                    },
                    {
                      "pattern": "^[A-Z][a-zA-Z]+$"
                    }
                  ]
                },
                "description": { "type": "string" },
                "format": { "type": "string" },
                "maxLength": { "type": "integer" },
                "minimum": { "type": "integer" },
                "maximum": { "type": "integer" },
                "optional": { "type": "boolean" },
                "default": {},
                "ref": { 
                  "type": "string",
                  "pattern": "^[A-Z][a-zA-Z]+$"
                },
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": { "type": "string" },
                    "ref": { "type": "string" },
                    "format": { "type": "string" },
                    "properties": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "type": { 
                            "type": "string",
                            "oneOf": [
                              {
                                "enum": ["string", "number", "integer", "boolean", "array", "object"]
                              },
                              {
                                "pattern": "^[A-Z][a-zA-Z]+$"
                              }
                            ]
                          },
                          "description": { "type": "string" },
                          "format": { "type": "string" },
                          "ref": { 
                            "type": "string",
                            "pattern": "^[A-Z][a-zA-Z]+$"
                          }
                        }
                      }
                    }
                  }
                },
                "enum": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "alias": { "type": "string" }
              }
            }
          },
          "required": {
            "type": "array",
            "items": { "type": "string" }
          },
          "validators": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
} 