{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "pipeline": {
    "build": {
      "dependsOn": [
        "^build",
        "^generate-models"
      ],
      "outputs": [
        "dist/**",
        "**/generated/**",
        "openapi.yaml",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "docs#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "build"
      ]
    },
    "run-examples": {
      "cache": false,
      "persistent": true
    },
    "generate-models": {
      "inputs": [
        "../../schemas/models.yaml",
        "generate_models.py"
      ],
      "outputs": [
        "../../apps/ts-sdk/src/types.ts",
        "../../apps/py-sdk/skribble/models.py"
      ],
      "cache": true
    },
    "publish-py-sdk": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}